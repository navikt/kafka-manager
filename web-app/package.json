{
	"name": "kafka-manager",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"start": "vite",
		"build": "tsc && vite build",
		"serve": "vite preview",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"test": "vitest run",
		"prettier": "prettier --write \"src/**/*.{ts,tsx,less,css,js,jsx}\""
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not ie <= 11",
		"not op_mini all"
	],
	"dependencies": {
		"@microlink/react-json-view": "1.31.51",
		"@navikt/aksel-icons": "8.23.0",
		"@navikt/ds-css": "8.23.0",
		"@navikt/ds-react": "8.23.0",
		"@navikt/ds-tokens": "8.23.0",
		"@tanstack/react-query": "5.108.0",
		"classnames": "2.5.1",
		"dayjs": "1.11.23",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-toastify": "11.2.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@testing-library/react": "16.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.14.0",
		"jsdom": "31.0.1",
		"msw": "^3.0.7",
		"prettier": "3.10.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	},
	"msw": {
		"workerDirectory": "public"
	}
}
