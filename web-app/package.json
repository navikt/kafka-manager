{
	"name": "kafka-manager",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"start": "vite",
		"build": "tsc && vite build",
		"serve": "vite preview",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"test": "vitest run",
		"prettier": "prettier --write \"src/**/*.{ts,tsx,less,css,js,jsx}\""
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not ie <= 11",
		"not op_mini all"
	],
	"dependencies": {
		"@microlink/react-json-view": "1.31.47",
		"@navikt/aksel-icons": "8.22.1",
		"@navikt/ds-css": "8.22.1",
		"@navikt/ds-react": "8.22.1",
		"@navikt/ds-tokens": "8.22.1",
		"classnames": "2.5.1",
		"dayjs": "1.11.23",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-toastify": "11.2.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.2.1",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.14.0",
		"msw": "^3.0.3",
		"prettier": "3.9.10",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.6",
		"vitest": "5.1.0"
	},
	"msw": {
		"workerDirectory": "public"
	}
}
