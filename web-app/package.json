{
	"name": "kafka-manager",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"start": "vite",
		"build": "tsc && vite build",
		"serve": "vite preview",
		"lint": "tslint ./src/**/*.ts*",
		"lint:fix": "tslint ./src/**/**/**/**/*.ts* --fix",
		"test": "vitest run",
		"prettier": "prettier --write \"src/**/*.{ts,tsx,less,css,js,jsx}\""
	},
	"eslintConfig": {
		"extends": "react-app"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx}": [
			"prettier --write",
			"tslint --fix"
		]
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not ie <= 11",
		"not op_mini all"
	],
	"dependencies": {
		"@microlink/react-json-view": "1.31.41",
		"@navikt/ds-css": "8.19.2",
		"@navikt/ds-react": "8.19.2",
		"@navikt/ds-tokens": "8.19.2",
		"@navikt/fnrvalidator": "2.2.1",
		"axios": "1.20.0",
		"classnames": "2.5.1",
		"constate": "4.0.0",
		"dayjs": "1.11.23",
		"lodash.throttle": "4.1.1",
		"prop-types": "15.8.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-toastify": "11.1.0"
	},
	"devDependencies": {
		"@types/classnames": "2.3.4",
		"@types/jest": "30.0.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/react-modal": "3.16.3",
		"@vitejs/plugin-react": "6.1.2",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"msw": "^2.15.0",
		"prettier": "3.9.10",
		"tslint": "6.1.3",
		"tslint-config-prettier": "1.18.0",
		"tslint-react": "5.0.0",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	},
	"overrides": {
		"esbuild": "0.28.2"
	},
	"msw": {
		"workerDirectory": "public"
	}
}
